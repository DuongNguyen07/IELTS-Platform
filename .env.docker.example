# ── Local Docker dev ───────────────────────────────────────────────────────────
# Copy relevant lines to .env.local when running docker-compose
# Start services: docker-compose up -d
# Then run Next.js normally: npm run dev

# PostgreSQL (local container — swap these in .env.local to go offline)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ielts_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ielts_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# AI service (Whisper + scoring)
AI_SERVICE_URL="http://localhost:8000"

# Whisper model size loaded inside the ai container
# tiny=fastest, base=balanced, small/medium/large=more accurate but slower
WHISPER_MODEL=base

# NextAuth
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI provider keys (at least one required for scoring endpoints)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
